# ============================================================
# AIGator — .rooignore
# ============================================================

# ── Backups (Proibido editar/ler para evitar confusão) ───────
assets/*.BACKUP.*
*.BACKUP.*
*.old
*.tmp

# ── Git ───────────────────────────────────────────────────────
.git/

# ── Snapshots e Dumps (Pesados e redundantes) ─────────────────
project_snapshot.md
dump_project_v2.py

# ── Scratch / Debug ───────────────────────────────────────────
scratch/
temp/

# ── Output Gerado ─────────────────────────────────────────────
output/

# ── Documentação de Specs (Somente leitura - via .clinerules) ─
# docs/ (Não ignoramos para permitir leitura, mas .clinerules proíbe escrita)

# ── Briefings Pessoais ────────────────────────────────────────
briefing-luc.md

# ── OS / Editor ───────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log

# ── AI Cache & Meta ───────────────────────────────────────────
.gemini/
.cursor/
.history/
.clinerules.bak
